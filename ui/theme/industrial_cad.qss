QMainWindow {
    background: {BG_MAIN};
}

QWidget {
    color: {TEXT_PRIMARY};
    font-size: 13px;
}

QToolBar#PrimaryRibbon {
    min-height: {PRIMARY_RIBBON_HEIGHT}px;
    max-height: {PRIMARY_RIBBON_HEIGHT}px;
    padding: 0px {SPACE_L}px;
    spacing: {SPACE_S}px;
    background: {BG_MAIN};
    border: none;
}

QMenuBar {
    background: {BG_MAIN};
    border-bottom: 1px solid {BORDER};
}

QMenu {
    background: {BG_PANEL};
    border: 1px solid {BORDER};
}

QTabWidget#SecondaryRibbon {
    background: {BG_MAIN};
    border-top: 1px solid {BORDER};
    border-bottom: 1px solid {BORDER};
}

QTabWidget#SecondaryRibbon::pane {
    border: none;
    margin-top: 0px;
}

QTabBar::tab {
    min-height: {TABS_HEIGHT}px;
    max-height: {TABS_HEIGHT}px;
    min-width: 96px;
    padding: 0px {SPACE_M}px;
    background: {BG_MAIN};
    border: none;
    color: {TEXT_SECONDARY};
    font-size: 12px;
    font-weight: 600;
}

QTabBar::tab:selected {
    color: {TEXT_PRIMARY};
    border-bottom: 2px solid {ACCENT};
}

QPushButton, QToolButton {
    min-height: {TOOL_BUTTON_HEIGHT}px;
    max-height: {TOOL_BUTTON_HEIGHT}px;
    padding: 0px {SPACE_M}px;
    background: {BG_PANEL};
    border: 1px solid {BORDER};
    border-radius: {RADIUS_BUTTON}px;
    color: {TEXT_PRIMARY};
    font-size: 12px;
    font-weight: 500;
}

QPushButton:hover, QToolButton:hover {
    background: {BG_HOVER};
}

QPushButton:checked, QToolButton:checked {
    border-color: {ACCENT};
    background: {BG_HOVER};
}

QPushButton:disabled, QToolButton:disabled {
    color: {TEXT_DISABLED};
    border-color: {BORDER};
}

QPushButton#primaryAction, QToolButton#primaryAction {
    background: {ACCENT};
    border: none;
    color: {ON_ACCENT};
    font-size: 12px;
    font-weight: 600;
}

QPushButton#primaryAction:hover, QToolButton#primaryAction:hover {
    background: {ACCENT};
}

QGroupBox {
    background: transparent;
    border: 1px solid {BORDER};
    border-radius: {RADIUS_PANEL}px;
    margin-top: {SPACE_M}px;
    padding-top: {SPACE_M}px;
}

QGroupBox::title {
    color: {TEXT_SECONDARY};
    left: {SPACE_S}px;
    padding: 0px {SPACE_XS}px;
    font-size: 12px;
    font-weight: 600;
}

QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox {
    min-height: {TOOL_BUTTON_HEIGHT}px;
    padding: 0px {SPACE_S}px;
    background: {BG_PANEL};
    border: 1px solid {BORDER};
    border-radius: {RADIUS_BUTTON}px;
}

QStatusBar {
    min-height: {STATUS_BAR_HEIGHT}px;
    max-height: {STATUS_BAR_HEIGHT}px;
    background: {BG_MAIN};
    border-top: 1px solid {BORDER};
    color: {TEXT_SECONDARY};
}

QStatusBar QLabel {
    color: {TEXT_SECONDARY};
}

QProgressBar {
    min-height: 24px;
    border: 1px solid {BORDER};
    border-radius: {RADIUS_BUTTON}px;
    background: {BG_PANEL};
}

QProgressBar::chunk {
    background: {ACCENT};
}

QFrame#Preview2DHeader {
    min-height: {PANEL_HEADER_HEIGHT}px;
    max-height: {PANEL_HEADER_HEIGHT}px;
    background: {BG_PANEL};
    border-bottom: 1px solid {BORDER};
}

QWidget#Preview2DPanel {
    background: {P2D_BG};
}

/* PH2 Unified Command Bar */
QFrame#headerArea {
    background: {BG_MAIN};
    border: none;
    border-bottom: 1px solid #3A4048;
}

QFrame#row1SystemBar {
    background: #1A1D21;
    border: none;
    border-bottom: 1px solid #3A4048;
}

QWidget#row2CommandBar {
    background: {BG_MAIN};
    border: none;
}

QToolButton#SystemBarButton {
    min-height: 24px;
    max-height: 24px;
    padding: 2px {SPACE_S}px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: {RADIUS_1}px;
    color: {TEXT_SECONDARY};
}

QToolButton#SystemBarButton:hover {
    background: {BG_HOVER};
    border-color: {BORDER};
    color: {TEXT_PRIMARY};
}

QToolButton#SystemBarButton:pressed {
    background: {BG_PANEL};
    border-color: {BORDER};
    color: {TEXT_PRIMARY};
}

QWidget#CommandBar,
QWidget#row2CommandBar {
    background: {BG_MAIN};
    border: none;
}

QFrame#Row1General,
QFrame#Row2Workflow {
    background: transparent;
    border: none;
}

QFrame#Row2Workflow {
    border-top: 1px solid {BORDER};
}

QLabel#FieldLabel {
    color: {TEXT_PRIMARY};
    font-size: 12px;
    font-weight: 500;
}

QFrame#CommandSeparator {
    background: {BORDER};
    border: none;
    min-width: 1px;
    max-width: 1px;
}

QFrame#Field {
    background: {BG_MAIN};
    border: 1px solid {BORDER};
    border-radius: {RADIUS_BUTTON}px;
}

QComboBox#Field {
    min-height: 32px;
    max-height: 32px;
    min-width: 160px;
    padding: 0px {SPACE_S}px;
    background: {BG_PANEL};
    border: 1px solid {BORDER};
    border-radius: {RADIUS_BUTTON}px;
}

QSlider#Field {
    min-height: 20px;
}

QWidget#CommandBar QPushButton,
QWidget#row2CommandBar QPushButton {
    text-align: left;
    padding-left: {SPACE_S}px;
    padding-right: {SPACE_S}px;
    border-radius: {RADIUS_BUTTON}px;
    font-weight: 500;
    font-size: 12px;
}

QPushButton#PrimaryButton,
QPushButton#btnRunFlattenPrimary {
    min-width: 172px;
    min-height: 44px;
    max-height: 44px;
    padding: 8px 14px;
    background: {ACCENT};
    border: none;
    border-radius: {RADIUS_BUTTON}px;
    color: {ON_ACCENT};
    font-weight: 700;
}

QPushButton#PrimaryButton:hover,
QPushButton#btnRunFlattenPrimary:hover {
    background: #17B6F0;
    border: none;
}

QPushButton#PrimaryButton:pressed,
QPushButton#PrimaryButton:checked,
QPushButton#btnRunFlattenPrimary:pressed,
QPushButton#btnRunFlattenPrimary:checked {
    background: #0996CD;
    border: none;
}

QPushButton#PrimaryButton:disabled,
QPushButton#btnRunFlattenPrimary:disabled {
    background: {BG_PANEL};
    border: 1px solid {BORDER};
    color: {TEXT_DISABLED};
}

QPushButton#SecondaryButton,
QPushButton#btnExportDxfSecondary {
    min-width: 148px;
    min-height: 40px;
    max-height: 40px;
    padding: 8px 12px;
    background: {BG_PANEL};
    border: 1px solid {ACCENT};
    border-radius: {RADIUS_BUTTON}px;
    color: {TEXT_PRIMARY};
    font-weight: 600;
}

QPushButton#SecondaryButton:hover,
QPushButton#btnExportDxfSecondary:hover {
    background: {BG_HOVER};
    border-color: {ACCENT};
}

QPushButton#SecondaryButton:pressed,
QPushButton#SecondaryButton:checked,
QPushButton#btnExportDxfSecondary:pressed,
QPushButton#btnExportDxfSecondary:checked {
    background: {BG_PANEL};
    border-color: {ACCENT};
}

QPushButton#SecondaryButton:disabled,
QPushButton#btnExportDxfSecondary:disabled {
    background: {BG_PANEL};
    border-color: {BORDER};
    color: {TEXT_DISABLED};
}

QPushButton#StandardButton {
    min-width: 120px;
    min-height: 40px;
    max-height: 40px;
    padding: 6px 10px;
    background: {BG_PANEL};
    border: 1px solid transparent;
    border-radius: {RADIUS_BUTTON}px;
    color: {TEXT_PRIMARY};
    font-weight: 500;
}

QPushButton#StandardButton:hover {
    background: {BG_HOVER};
    border-color: {BORDER};
}

QPushButton#StandardButton:pressed {
    background: {BG_PANEL};
    border-color: {BORDER};
}

QPushButton#ToggleButton {
    min-width: 120px;
    min-height: 40px;
    max-height: 40px;
    padding: 6px 10px;
    background: {BG_PANEL};
    border: 1px solid transparent;
    border-radius: {RADIUS_BUTTON}px;
    color: {TEXT_PRIMARY};
    font-weight: 500;
}

QPushButton#ToggleButton:hover {
    background: {BG_HOVER};
    border-color: {BORDER};
}

QPushButton#ToggleButton:pressed {
    background: {BG_PANEL};
    border-color: {BORDER};
}

QPushButton#ToggleButton:checked {
    border: 1px solid {ACCENT};
    background: {BG_HOVER};
    color: {TEXT_PRIMARY};
}

QPushButton#ToggleButton:checked:hover {
    border-color: {ACCENT};
    background: {BG_HOVER};
}

QPushButton#ToggleButton:disabled,
QPushButton#ToggleButton:checked:disabled {
    background: {BG_PANEL};
    border-color: {BORDER};
    color: {TEXT_DISABLED};
}

QWidget#CommandBar QPushButton:disabled,
QWidget#row2CommandBar QPushButton:disabled {
    color: {TEXT_DISABLED};
    border-color: {BORDER};
}
